exports[`route-level visual regression snapshots > matches dashboard visual shell snapshot 1`] = `"<div class="stable-scroll-scope space-y-6"><header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"><div class="space-y-2"><h1 class="cyber-title break-anywhere text-3xl font-semibold tracking-tight text-white sm:text-4xl">Dashboard</h1><p class="cyber-copy-muted readable-measure break-anywhere max-w-[54ch] text-sm leading-7 sm:text-base">Identity, progression, and report lanes.</p><div class="flex flex-wrap items-center gap-2"><ul role="list" class="flex flex-wrap items-center gap-2 text-xs"><li class="list-none"><span class="neon-chip neon-chip-muted rounded-full px-3 py-1">Rank Gold III</span></li><li class="list-none"><span class="neon-chip neon-chip-muted rounded-full px-3 py-1">Merged PRs 12</span></li><li class="list-none"><span class="neon-chip neon-chip-muted rounded-full px-3 py-1">Streak 0d</span></li><li class="list-none"><span class="neon-chip neon-chip-success rounded-full px-3 py-1">Sync Synced</span></li></ul></div></div><div class="flex flex-wrap items-center gap-2"><a href="/dashboard/contributions">View PR cards</a></div></header><section><div class="glass-panel-strong cyber-card cyber-frame neon-outline rounded-[var(--radius-card)] p-5 sm:p-6 player-card-shell cyber-hero-shell space-y-6 overflow-hidden"><div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"><div class="flex items-center gap-4"><div class="rank-orbit rounded-[2rem] p-[2px]"><img alt="Live Fixture Maintainer avatar" src="https://example.com/avatar.png"></div><div class="space-y-2"><div class="flex flex-wrap items-center gap-3"><p class="break-anywhere text-2xl font-semibold text-white">Live Fixture Maintainer</p><div class="hud-pill inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-medium text-amber-100"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crown h-4 w-4" aria-hidden="true"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path><path d="M5 21h14"></path></svg><span>Gold III</span></div></div><p class="text-sm text-muted">@live-maintainer</p><p class="break-anywhere text-sm text-muted">Live Systems Builder • Systems Builder</p></div></div><div class="flex flex-wrap items-center gap-2"><a href="/u/live-maintainer">Public profile<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div><div class="grid gap-4 md:grid-cols-3"><div class="neon-metric rounded-[1.75rem] p-5"><p class="text-xs font-medium text-primary">Level</p><p class="mt-3 text-4xl font-semibold text-white"><span>7</span></p></div><div class="neon-metric rounded-[1.75rem] p-5"><p class="text-xs font-medium text-primary">Total XP</p><p class="mt-3 text-4xl font-semibold text-white"><span>2,468</span></p></div><div class="neon-metric rounded-[1.75rem] p-5"><p class="text-xs font-medium text-primary">To next level</p><p class="mt-3 text-lg font-medium text-white"><span class="numeric-readout">532</span> XP left</p><p class="mt-2 text-sm text-muted">Target: <span class="numeric-readout">3,000</span> XP</p></div></div><div class="space-y-2"><div aria-valuemax="100" aria-valuemin="0" aria-valuenow="82" aria-valuetext="82%" role="progressbar" data-state="loading" data-value="82" data-max="100" class="neon-track relative h-3 overflow-hidden rounded-full"><div data-state="loading" data-value="82" data-max="100" class="h-full rounded-full bg-gradient-to-r from-primary via-primary-2 to-success shadow-[0_0_12px_rgb(34_226_255_/_0.24)]" style="transform: translateX(-18%);"></div></div><div class="flex items-center justify-between text-xs text-muted"><span>82% toward next level</span><span>3,000 XP target</span></div></div><div class="rounded-[1.75rem] border border-emerald-400/16 bg-emerald-400/8 p-4"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles mt-0.5 h-4 w-4 text-emerald-200" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg><div><p class="text-sm font-semibold text-white">Rank-up preview</p><p class="mt-1 text-sm leading-6 text-muted">532 XP to Platinum I.</p></div></div></div><div class="rounded-[1.75rem] border border-primary/18 bg-primary/8 p-4"><div class="flex flex-wrap items-start justify-between gap-3"><div class="space-y-1"><p class="text-sm font-semibold text-white">Continue active quest</p><p class="text-sm leading-6 text-muted">Quest completion is the fastest path to rank movement this cycle.</p></div><a href="/dashboard/quests">Open quests<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div><div class="rounded-[1.75rem] border border-cyan-300/20 bg-cyan-400/8 p-4"><div class="flex flex-wrap items-center justify-between gap-2"><p class="text-xs font-medium text-cyan-200">Identity brief (Deterministic)</p><div class="inline-flex flex-col items-start gap-1"><button class="focus-ring inline-flex items-center gap-2 rounded-[0.1rem] border border-transparent font-medium disabled:pointer-events-none disabled:opacity-50 text-muted hover:border-primary/22 hover:bg-primary/10 hover:text-white h-10 px-4 text-sm min-w-[8.5rem] justify-center" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy h-4 w-4" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>Copy summary</button><span class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span></div></div><div class="space-y-2 mt-2"><p id="_r_0_" class="break-anywhere break-anywhere text-sm leading-6 text-muted" style="display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;">Live Fixture Maintainer is currently Gold III (Level 7) with 2,468 total XP from 12 merged PRs across 1 repositories. Recent strength signals are concentrated around Backend and Testing, with a current streak of 0 days in the Last 30 days window.</p><button class="focus-ring inline-flex items-center justify-center gap-2 rounded-[0.1rem] border border-transparent font-medium disabled:pointer-events-none disabled:opacity-50 text-muted hover:border-primary/22 hover:bg-primary/10 hover:text-white h-auto px-0 py-0 text-xs" type="button" aria-expanded="false" aria-controls="_r_0_">Show more</button></div></div><div class="space-y-3"><p class="text-xs font-medium text-primary">Top signals</p><ul role="list" class="flex flex-wrap gap-2"><li class="list-none"><span class="neon-chip neon-chip-muted inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3.5 w-3.5 text-primary" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>Backend</span></li><li class="list-none"><span class="neon-chip neon-chip-muted inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-3.5 w-3.5 text-primary" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>Testing</span></li></ul></div></div></section><section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-12"><div class="glass-panel cyber-frame rounded-[var(--radius-card)] p-5 sm:p-6 cyber-sheen space-y-3 xl:col-span-6"><div class="flex items-center justify-between text-muted"><span class="text-sm">GitRank score</span><span class="hud-pill rounded-2xl p-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-medal h-5 w-5 text-primary" aria-hidden="true"><path d="M7.21 15 2.66 7.14a2 2 0 0 1 .13-2.2L4.4 2.8A2 2 0 0 1 6 2h12a2 2 0 0 1 1.6.8l1.6 2.14a2 2 0 0 1 .14 2.2L16.79 15"></path><path d="M11 12 5.12 2.2"></path><path d="m13 12 5.88-9.8"></path><path d="M8 7h8"></path><circle cx="12" cy="17" r="5"></circle><path d="M12 18v-2h-.5"></path></svg></span></div><div class="numeric-readout font-semibold tracking-tight text-4xl">2468</div><p class="text-sm leading-6 text-muted">Impact-weighted score from merged evidence.</p></div><div class="glass-panel cyber-frame rounded-[var(--radius-card)] p-5 sm:p-6 xl:col-span-3 space-y-4"><div class="flex items-center justify-between text-muted"><span class="text-sm">Current streak</span><span class="hud-pill rounded-2xl p-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flame h-5 w-5 text-primary" aria-hidden="true"><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"></path></svg></span></div><div class="numeric-readout text-3xl font-semibold tracking-tight">0d</div><p class="text-sm leading-6 text-muted">Best 1d • 1 active days this year</p></div><div class="glass-panel cyber-frame rounded-[var(--radius-card)] p-5 sm:p-6 cyber-sheen space-y-3 xl:col-span-3"><div class="flex items-center justify-between text-muted"><span class="text-sm">Merged PRs</span><span class="hud-pill rounded-2xl p-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity h-5 w-5 text-primary" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></span></div><div class="numeric-readout text-3xl font-semibold tracking-tight">12</div><p class="text-sm leading-6 text-muted">Merged work is the primary ranking evidence.</p></div></section><div class="grid gap-6 xl:grid-cols-[0.86fr,1.14fr]"><div class="space-y-6"><section class="render-opt-section"><div class="glass-panel cyber-frame rounded-[var(--radius-card)] p-5 sm:p-6 min-h-[15rem] space-y-3"><p class="text-xs font-medium text-primary">Loading league</p><div class="neon-skeleton h-10 w-3/5"></div><div class="neon-skeleton h-24 w-full"></div></div></section><section class="render-opt-section"><div class="glass-panel cyber-frame rounded-[var(--radius-card)] p-5 sm:p-6 min-h-[15rem] space-y-3"><p class="text-xs font-medium text-primary">Loading quests</p><div class="neon-skeleton h-10 w-3/5"></div><div class="neon-skeleton h-24 w-full"></div></div></section></div><div class="space-y-6"><section class="render-opt-section"><div class="glass-panel cyber-frame rounded-[var(--radius-card)] p-5 sm:p-6 min-h-[15rem] space-y-3"><p class="text-xs font-medium text-primary">Loading reports</p><div class="neon-skeleton h-10 w-3/5"></div><div class="neon-skeleton h-24 w-full"></div></div></section></div></div></div>"`;

exports[`route-level visual regression snapshots > matches leaderboard visual shell snapshot 1`] = `"<div class="stable-scroll-scope space-y-6"><header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"><div class="space-y-2"><h1 class="cyber-title break-anywhere text-3xl font-semibold tracking-tight text-white sm:text-4xl">Leaderboard</h1><p class="cyber-copy-muted readable-measure break-anywhere max-w-[54ch] text-sm leading-7 sm:text-base">Rank lanes and promotion progress.</p><div class="flex flex-wrap items-center gap-2"><ul role="list" class="flex flex-wrap items-center gap-2 text-xs"><li class="list-none"><span class="neon-chip neon-chip-muted rounded-full px-3 py-1">Lane Global</span></li><li class="list-none"><span class="neon-chip neon-chip-muted rounded-full px-3 py-1">Rows 1</span></li><li class="list-none"><span class="neon-chip neon-chip-muted rounded-full px-3 py-1">Showing 1</span></li><li class="list-none"><span class="neon-chip neon-chip-success rounded-full px-3 py-1">Sync Synced</span></li></ul></div></div><div class="flex flex-wrap items-center gap-2"><a href="/dashboard/quests">Quests</a></div></header><section class="space-y-3"><div class="space-y-2"><p class="text-xs font-medium text-primary">Lane</p><div role="tablist" aria-orientation="horizontal" aria-label="Leaderboard lane filters" data-segmented-tablist="true" class="dashboard-nav-track lane-rail flex flex-wrap gap-1.5 overflow-visible p-0.5 w-full"><ul role="list" class="contents"><li class="list-none shrink-0 min-w-[9rem]"><button type="button" role="tab" id="leaderboard-lane-tab-global" title="Global" aria-label="Global" aria-controls="leaderboard-rows-region" aria-selected="true" tabindex="0" data-active="true" data-segmented-option="true" data-segmented-value="Global" class="focus-ring dashboard-nav-item min-h-11 w-full px-3 py-2 text-center text-sm font-semibold"><span class="inline-flex items-center gap-2"><span aria-hidden="true" class="dashboard-nav-icon h-4 w-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-earth h-4 w-4" aria-hidden="true"><path d="M21.54 15H17a2 2 0 0 0-2 2v4.54"></path><path d="M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17"></path><path d="M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05"></path><circle cx="12" cy="12" r="10"></circle></svg></span><span class="truncate">Global</span></span></button></li><li class="list-none shrink-0 min-w-[9rem]"><button type="button" role="tab" id="leaderboard-lane-tab-backend" title="Backend" aria-label="Backend" aria-controls="leaderboard-rows-region" aria-selected="false" tabindex="-1" data-active="false" data-segmented-option="true" data-segmented-value="Backend" class="focus-ring dashboard-nav-item min-h-11 w-full px-3 py-2 text-center text-sm font-semibold"><span class="inline-flex items-center gap-2"><span aria-hidden="true" class="dashboard-nav-icon h-4 w-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu h-4 w-4" aria-hidden="true"><path d="M12 20v2"></path><path d="M12 2v2"></path><path d="M17 20v2"></path><path d="M17 2v2"></path><path d="M2 12h2"></path><path d="M2 17h2"></path><path d="M2 7h2"></path><path d="M20 12h2"></path><path d="M20 17h2"></path><path d="M20 7h2"></path><path d="M7 20v2"></path><path d="M7 2v2"></path><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg></span><span class="truncate">Backend</span></span></button></li><li class="list-none shrink-0 min-w-[9rem]"><button type="button" role="tab" id="leaderboard-lane-tab-testing" title="Testing" aria-label="Testing" aria-controls="leaderboard-rows-region" aria-se