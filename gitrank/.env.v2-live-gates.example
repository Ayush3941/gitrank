# Copy this file to a local untracked env file before running live V2 gates.
# Do not commit real tokens or secrets.

# GitHub repository controls gate
GITHUB_REPOSITORY=OWNER/REPO
GITRANK_REPO_ADMIN_TOKEN=replace-me-with-repo-admin-token
# GITHUB_TOKEN=replace-me-with-repo-admin-token
# Optional GitHub API timeout (seconds) used by live-gate scripts
# GITHUB_API_TIMEOUT_SECONDS=30

# Optional GitHub App token bootstrap inputs (if not using a PAT directly)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
# GITHUB_APP_PRIVATE_KEY_PEM=
# Optional aliases used by GitHub Actions secrets naming:
# GITRANK_GITHUB_APP_ID=
# GITRANK_GITHUB_APP_INSTALLATION_ID=
# GITRANK_GITHUB_APP_PRIVATE_KEY_FILE=
# GITRANK_GITHUB_APP_PRIVATE_KEY_PEM=

# Optional workflow-run evidence inputs
# VERIFY_FROM_WORKFLOW=true
# WORKFLOW_RUN_ID= # optional; defaults to latest successful workflow_dispatch run
# WORKFLOW_EVENT=workflow_dispatch
# USE_LATEST_SUCCESSFUL_RUN=true
# WORKFLOW_RUN_ID_FILE=.tmp/live-v2-workflow-run-id.txt
# OUTPUT_FILE=docs/evidence/observability-live-YYYY-MM-DD.txt
# ENVIRONMENT=staging
# CLUSTER=your-cluster
# NAMESPACE=gitrank
# OPERATOR=your-name

# Optional pipeline guard for run-live-v2-workflow-evidence-pipeline
# CONFIRM_RUN_LIVE_V2_PIPELINE=yes
# AUTO_GENERATE_OBSERVABILITY_EVIDENCE=true
# AUTO_SYNC_REMOTE_WORKFLOW=true

# Observability gate
PROMETHEUS_BASE_URL=https://prometheus.your-env.example
GRAFANA_BASE_URL=https://grafana.your-env.example
GRAFANA_API_TOKEN=replace-me-with-grafana-api-token
# OBS_HTTP_TIMEOUT_SECONDS=30

# Kubernetes runtime render gate
K8S_ENVIRONMENT=staging
IMAGE_TAG=replace-me-with-release-tag
IMAGE_REGISTRY_OWNER=replace-me-with-registry-owner
K8S_PUBLIC_BASE_URL=https://staging.gitrank.dev
K8S_API_BASE_URL=https://api.staging.gitrank.dev
K8S_AUTH_COOKIE_DOMAIN=.staging.gitrank.dev
K8S_GITHUB_OAUTH_REDIRECT_URL=https://auth.staging.gitrank.dev/oauth/github/callback
K8S_API_HOST=api.staging.gitrank.dev
K8S_AUTH_HOST=auth.staging.gitrank.dev
K8S_TLS_SECRET_NAME=gitrank-staging-tls

# Finalizer multi-environment runtime proof (required by default when
# RUN_K8S_RUNTIME=true and VERIFY_FROM_WORKFLOW!=true)
REQUIRE_ENV_SPECIFIC_K8S_OVERRIDES=true
STAGING_K8S_PUBLIC_BASE_URL=https://staging.gitrank.dev
PRODUCTION_K8S_PUBLIC_BASE_URL=https://gitrank.dev
STAGING_K8S_API_BASE_URL=https://api.staging.gitrank.dev
PRODUCTION_K8S_API_BASE_URL=https://api.gitrank.dev
STAGING_K8S_AUTH_COOKIE_DOMAIN=.staging.gitrank.dev
PRODUCTION_K8S_AUTH_COOKIE_DOMAIN=.gitrank.dev
STAGING_K8S_GITHUB_OAUTH_REDIRECT_URL=https://auth.staging.gitrank.dev/oauth/github/callback
PRODUCTION_K8S_GITHUB_OAUTH_REDIRECT_URL=https://auth.gitrank.dev/oauth/github/callback
STAGING_K8S_API_HOST=api.staging.gitrank.dev
PRODUCTION_K8S_API_HOST=api.gitrank.dev
STAGING_K8S_AUTH_HOST=auth.staging.gitrank.dev
PRODUCTION_K8S_AUTH_HOST=auth.gitrank.dev
STAGING_K8S_TLS_SECRET_NAME=gitrank-staging-tls
PRODUCTION_K8S_TLS_SECRET_NAME=gitrank-production-tls

# Optional per-environment image overrides
# STAGING_IMAGE_TAG=
# PRODUCTION_IMAGE_TAG=
# STAGING_IMAGE_REGISTRY_OWNER=
# PRODUCTION_IMAGE_REGISTRY_OWNER=

# Optional workflow-dispatch details behavior
# RETURN_RUN_DETAILS=true

# Evidence files (for checklist-marking stage)
OBS_EVIDENCE_FILE=docs/evidence/observability-live-YYYY-MM-DD.txt
ROLLBACK_EVIDENCE_FILE=docs/evidence/rollback-drill-YYYY-MM-DD.txt
RESTORE_EVIDENCE_FILE=docs/evidence/database-restore-drill-YYYY-MM-DD.txt

# Optional rollback/restore evidence generation inputs
# AUTO_GENERATE_ROLLBACK_RESTORE_EVIDENCE=true
# SEED_HTTP_TIMEOUT_SECONDS=30
# ROLLBACK_STARTING_COMMIT=
# ROLLBACK_CANDIDATE_COMMIT=
# ROLLBACK_TARGET_REVISION=
# ROLLBACK_DATABASE_BACKUP_MARKER=
# ROLLBACK_WORKFLOW_RUN_URL=
# ROLLBACK_HISTORY_CAPTURED=
# ROLLBACK_MODE=
# ROLLBACK_STATUS_RESULTS=
# ROLLBACK_CRITICAL_PRODUCT_CHECKS=
# ROLLBACK_OBSERVED_ERRORS=none observed
# ROLLBACK_FOLLOW_UP_ACTIONS=none
# ROLLBACK_DECISION=pass
# RESTORE_SOURCE=
# RESTORE_TARGET=
# RESTORE_BACKUP_IDENTIFIER=
# RESTORE_START_TIMESTAMP=
# RESTORE_COMPLETION_TIMESTAMP=
# RESTORE_COMMAND_OR_WORKFLOW=
# RESTORE_SCHEMA_MIGRATION_STATE=
# RESTORE_CRITICAL_PRODUCT_CHECKS=
# RESTORE_OBSERVED_ERRORS=none observed
# RESTORE_FOLLOW_UP_ACTIONS=none
# RESTORE_DECISION=pass
