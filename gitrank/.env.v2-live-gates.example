# Copy this file to a local untracked env file before running live V2 gates.
# Do not commit real tokens or secrets.

# GitHub repository controls gate
GITHUB_REPOSITORY=OWNER/REPO
GITHUB_TOKEN=replace-me-with-repo-admin-token

# Observability gate
PROMETHEUS_BASE_URL=https://prometheus.your-env.example
GRAFANA_BASE_URL=https://grafana.your-env.example
GRAFANA_API_TOKEN=replace-me-with-grafana-api-token

# Kubernetes runtime render gate
K8S_ENVIRONMENT=staging
IMAGE_TAG=replace-me-with-release-tag
IMAGE_REGISTRY_OWNER=replace-me-with-registry-owner
K8S_PUBLIC_BASE_URL=https://staging.gitrank.dev
K8S_API_BASE_URL=https://api.staging.gitrank.dev
K8S_AUTH_COOKIE_DOMAIN=.staging.gitrank.dev
K8S_GITHUB_OAUTH_REDIRECT_URL=https://auth.staging.gitrank.dev/oauth/github/callback
K8S_API_HOST=api.staging.gitrank.dev
K8S_AUTH_HOST=auth.staging.gitrank.dev
K8S_TLS_SECRET_NAME=gitrank-staging-tls

# Evidence files (for checklist-marking stage)
OBS_EVIDENCE_FILE=docs/evidence/observability-live-YYYY-MM-DD.txt
ROLLBACK_EVIDENCE_FILE=docs/evidence/rollback-drill-YYYY-MM-DD.txt
RESTORE_EVIDENCE_FILE=docs/evidence/database-restore-drill-YYYY-MM-DD.txt
