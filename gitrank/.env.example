# Core runtime
GITRANK_ENV=development
GITRANK_SERVICE_NAME=gitrank-local
GITRANK_LOG_LEVEL=info
GITRANK_LOG_FORMAT=text
GITRANK_SHUTDOWN_TIMEOUT=10s

# Public endpoints
GITRANK_PUBLIC_BASE_URL=http://localhost:3000
GITRANK_API_BASE_URL=http://localhost:8080
GITRANK_CSP_MODE=report-only

# Service listen addresses
API_GATEWAY_ADDR=:8080
AUTH_SERVICE_ADDR=:8081
GITHUB_INGESTOR_ADDR=:8082
PR_ANALYZER_ADDR=:8083
PROFILE_SERVICE_ADDR=:8084
SCORING_ENGINE_ADDR=:8085
SCHEDULER_WORKER_ADDR=:8086

# Internal service-to-service APIs
AUTH_SERVICE_BASE_URL=http://localhost:8081
# Frontend auth-proxy alias; frontend routes also accept AUTH_SERVICE_BASE_URL.
GITRANK_AUTH_BASE_URL=http://localhost:8081
GITHUB_INGESTOR_BASE_URL=http://localhost:8082
PR_ANALYZER_BASE_URL=http://localhost:8083
PROFILE_SERVICE_BASE_URL=http://localhost:8084
SCORING_ENGINE_BASE_URL=http://localhost:8085
SCHEDULER_WORKER_BASE_URL=http://localhost:8086
INTERNAL_API_REQUEST_TIMEOUT=5s
PROFILE_PUBLIC_CACHE_TTL=5m
PROFILE_PRIVATE_CACHE_TTL=2m
PROFILE_SNAPSHOT_STALE_TTL=15m
PROFILE_RECENT_REPORTS_DEFAULT_LIMIT=4
PROFILE_RECENT_REPORTS_MAX_LIMIT=10
PROFILE_REPORT_BACKFILL_DEFAULT_LIMIT=50
PROFILE_REPORT_BACKFILL_MAX_LIMIT=200
PROFILE_ACCOUNT_EXPORT_AUDIT_LIMIT=200

# Database and cache
DATABASE_URL=postgres://localhost:55432/gitrank?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Local development helper for seeded sample data
ALLOW_LOCAL_SEED=0

# Auth
GITRANK_SESSION_SECRET=replace-with-a-long-random-secret
GITRANK_PREVIOUS_SESSION_SECRETS=
GITRANK_JWT_SIGNING_KEY=replace-with-a-long-random-signing-key
AUTH_SESSION_COOKIE_NAME=gitrank_session
AUTH_CSRF_COOKIE_NAME=gitrank_csrf
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_SESSION_TTL=720h
AUTH_SESSION_IDLE_TTL=72h
AUTH_SESSION_ROTATION_INTERVAL=24h
AUTH_OAUTH_STATE_TTL=10m
AUTH_ADMIN_GITHUB_LOGINS=
AUTH_MAINTAINER_GITHUB_LOGINS=
AUTH_RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX_ATTEMPTS=30

# GitHub OAuth app
# This is the required v1 GitHub auth path.
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_EXCHANGE_URL=https://github.com/login/oauth/access_token
# Optional legacy alias still accepted by config loader.
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_DEVICE_URL=https://github.com/login/device/code
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3000/oauth/github/callback
GITHUB_OAUTH_SCOPES=read:user,user:email

# GitHub App
# Optional future-upgrade path. Not required for the v1 production baseline.
# For app JWT auth, GitHub accepts either App ID or App Client ID as issuer.
GITHUB_APP_ID=0
GITHUB_APP_SLUG=replace-me
GITHUB_APP_INSTALL_URL=
GITHUB_APP_CLIENT_ID=replace-me
GITHUB_APP_CLIENT_SECRET=replace-me
GITHUB_APP_PRIVATE_KEY_PEM_PATH=./secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql
GITHUB_API_VERSION=2026-03-10
GITHUB_USER_AGENT=GitRank/dev
GITHUB_REQUEST_TIMEOUT=20s
GITHUB_MAX_PAGE_SIZE=100
GITHUB_GRAPHQL_PAGE_SIZE=100
GITHUB_REPOSITORY_SYNC_PAGE_SIZE=10
GITHUB_PULL_REQUEST_REVIEW_PAGE_SIZE=10
GITHUB_COMMIT_SYNC_PAGE_SIZE=50
GITHUB_USER_REPOSITORY_SYNC_LIMIT=100
GITHUB_INSTALLATION_REPOSITORY_PAGE_SIZE=50
GITHUB_INSTALLATION_REPOSITORY_MAX_PAGES=10
GITHUB_AUTHORED_PR_SEARCH_LIMIT=100
GITHUB_AUTHORED_PR_SYNC_LIMIT=10
GITHUB_SYNC_RUN_DEFAULT_LIMIT=50
GITHUB_SYNC_RUN_MAX_LIMIT=200
GITHUB_USER_PR_SYNC_TIMEOUT_DEFAULT=45s
GITHUB_USER_PR_SYNC_TIMEOUT_MIN=20s
GITHUB_USER_PR_SYNC_TIMEOUT_MAX=90s
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576
GITHUB_WEBHOOK_DEDUPE_TTL=168h
GITHUB_FAILED_DELIVERY_LOOKBACK=72h
GITHUB_INSTALLATION_REFRESH_SKEW=5m
GITHUB_SECONDARY_RATE_LIMIT_BACKOFF=1m
GITHUB_REPOSITORY_CACHE_TTL=10m
GITHUB_MAX_CONCURRENT_REQUESTS=8
GITHUB_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GITHUB_CIRCUIT_BREAKER_OPEN_INTERVAL=30s
GITHUB_CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1

# Future GitHub integration reminders not wired yet
GITHUB_APP_REQUIRED_EVENTS=installation,installation_repositories,pull_request,pull_request_review,pull_request_review_comment,issues,push
GITHUB_APP_REQUIRED_PERMISSIONS=metadata=read,contents=read,pull_requests=read,issues=read,checks=read
GITHUB_WEBHOOK_PUBLIC_URL=http://localhost:8082/webhooks/github
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
GITHUB_PREVIOUS_TOKEN_ENCRYPTION_KEYS=

# AI provider
AI_PROVIDER=openai
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT=20s
AI_SUMMARY_MAX_RUNES=320
AI_SUMMARY_PROMPT_FILE_PATH_LIMIT=12
# Optional JSON override for deterministic PR analyzer logic
# Example: {"small_change_max_files":4,"review_meaningful_threshold":1.2}
AI_ANALYZER_POLICY_JSON=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional compatibility aliases for provider-specific overrides.
# If AI_PROVIDER=gemini, these can be used instead of OPENAI_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODERATION_MODEL=
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_PR_MAX_CHANGED_FILES=100
AI_PR_MAX_FILE_RECORDS=100
AI_PR_MAX_DIFF_LINES=5000
AI_PR_MAX_INPUT_CHARS=120000
AI_PR_MAX_ESTIMATED_TOKENS=30000
AI_PR_MAX_ESTIMATED_COST_USD=0.25
AI_ESTIMATED_INPUT_TOKEN_COST_USD=0.000005

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=gitrank
OTEL_METRICS_ENABLED=true
OTEL_TRACES_ENABLED=true

# Queue and scheduling
SCHEDULER_RUN_MODE=combined
SCHEDULER_SYNC_CRON=0 */6 * * *
JOB_MAX_ATTEMPTS=10
JOB_RETRY_BACKOFF=30s
JOB_WORKER_CONCURRENCY=4
JOB_LEASE_TTL=2m
JOB_POLL_INTERVAL=5s
JOB_DEAD_LETTER_QUEUE=github-sync-dead-letter
JOB_PER_USER_RATE_WINDOW=15m
JOB_PER_USER_RATE_MAX=6
JOB_PER_INSTALLATION_RATE_WINDOW=15m
JOB_PER_INSTALLATION_RATE_MAX=18

# Frontend polling and auto-sync policy (milliseconds)
NEXT_PUBLIC_GITRANK_AUTO_SYNC_RETRY_INTERVAL_MS=90000
NEXT_PUBLIC_GITRANK_AUTO_SYNC_STALE_AGE_MS=21600000
NEXT_PUBLIC_GITRANK_AUTO_SYNC_MAX_ATTEMPTS_PER_MOUNT=3
NEXT_PUBLIC_GITRANK_AUTO_SYNC_ATTEMPT_RECOVERY_COOLDOWN_MS=600000
NEXT_PUBLIC_GITRANK_AUTO_SYNC_SESSION_COOLDOWN_MS=1200000
NEXT_PUBLIC_GITRANK_AUTO_SYNC_SESSION_BOOTSTRAP_ENABLED=true
NEXT_PUBLIC_GITRANK_USER_SYNC_EXECUTION_TIMEOUT_MS=180000
NEXT_PUBLIC_GITRANK_USER_SYNC_RETRY_MAX_ATTEMPTS=2
NEXT_PUBLIC_GITRANK_USER_SYNC_RETRY_BASE_DELAY_MS=700
NEXT_PUBLIC_GITRANK_USER_SYNC_RETRY_JITTER_MS=250
NEXT_PUBLIC_GITRANK_USER_SYNC_RETRY_MAX_DELAY_MS=8000
NEXT_PUBLIC_GITRANK_PROFILE_SYNC_REFETCH_INTERVAL_MS=20000
NEXT_PUBLIC_GITRANK_PROFILE_SYNC_REFETCH_INTERVAL_CONSTRAINED_MS=75000
NEXT_PUBLIC_GITRANK_PROFILE_SYNC_STALE_TIME_MS=20000
NEXT_PUBLIC_GITRANK_PROFILE_SYNC_STALE_TIME_CONSTRAINED_MS=60000
NEXT_PUBLIC_GITRANK_SYNC_RUNS_IDLE_REFETCH_INTERVAL_MS=180000
NEXT_PUBLIC_GITRANK_SYNC_RUNS_ACTIVE_REFETCH_INTERVAL_MS=45000
NEXT_PUBLIC_GITRANK_SYNC_RUNS_IDLE_REFETCH_INTERVAL_CONSTRAINED_MS=300000
NEXT_PUBLIC_GITRANK_SYNC_RUNS_ACTIVE_REFETCH_INTERVAL_CONSTRAINED_MS=90000
NEXT_PUBLIC_GITRANK_SYNC_RUNS_STALE_TIME_MS=30000
NEXT_PUBLIC_GITRANK_SYNC_RUNS_STALE_TIME_CONSTRAINED_MS=90000
NEXT_PUBLIC_GITRANK_PROFILE_SYNC_RUN_LOOKBACK_LIMIT=50

# Frontend display policy (optional overrides)
NEXT_PUBLIC_GITRANK_CSRF_COOKIE_NAME=gitrank_csrf
NEXT_PUBLIC_GITRANK_SCORE_VERSION_FALLBACK=v1alpha1
NEXT_PUBLIC_GITRANK_CONTRIBUTION_CARD_PAGE_SIZE=12
NEXT_PUBLIC_GITRANK_CONTRIBUTION_CARD_PAGE_SIZE_CONSTRAINED=6
NEXT_PUBLIC_GITRANK_CONTRIBUTION_RENDER_HARD_CAP=100
NEXT_PUBLIC_GITRANK_ABRA_CONTRIBUTION_SAMPLE_LIMIT=24
NEXT_PUBLIC_GITRANK_HIGH_XP_THRESHOLD=200
NEXT_PUBLIC_GITRANK_RANK_TIER_BRONZE_LABEL=Bronze I
NEXT_PUBLIC_GITRANK_RANK_TIER_SILVER_LABEL=Silver II
NEXT_PUBLIC_GITRANK_RANK_TIER_GOLD_LABEL=Gold III
NEXT_PUBLIC_GITRANK_RANK_TIER_PLATINUM_LABEL=Platinum I
NEXT_PUBLIC_GITRANK_RANK_TIER_DIAMOND_LABEL=Diamond
NEXT_PUBLIC_GITRANK_DIVISION_BRONZE=Bronze Foundry
NEXT_PUBLIC_GITRANK_DIVISION_SILVER=Silver Workshop
NEXT_PUBLIC_GITRANK_DIVISION_GOLD=Gold Forge
NEXT_PUBLIC_GITRANK_DIVISION_PLATINUM=Platinum Crucible
NEXT_PUBLIC_GITRANK_DIVISION_DIAMOND=Diamond Arena
NEXT_PUBLIC_GITRANK_LEADERBOARD_PROMOTION_RULE=Top 25 move toward the next rank tier when the season locks.
NEXT_PUBLIC_GITRANK_LEADERBOARD_RESET_RULE=Weekly XP resets after the window; total XP and score evidence are retained.
NEXT_PUBLIC_GITRANK_LEADERBOARD_PROMOTION_CUTOFF_RANK=25
NEXT_PUBLIC_GITRANK_LEADERBOARD_SAFETY_CUTOFF_RANK=75
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.35

# Scoring policy (deterministic, env-driven)
SCORING_SCORE_VERSION=v1alpha1
SCORING_BASE_XP=100
SCORING_MIN_XP=10
SCORING_LEVEL_STEP_XP=300
SCORING_PROFILE_SCORE_HISTORY_LIMIT=100
SCORING_HIGH_XP_THRESHOLD=200
SCORING_RANK_TIER_BRONZE_LABEL=Bronze I
SCORING_RANK_TIER_SILVER_LABEL=Silver II
SCORING_RANK_TIER_GOLD_LABEL=Gold III
SCORING_RANK_TIER_PLATINUM_LABEL=Platinum I
SCORING_RANK_TIER_DIAMOND_LABEL=Diamond
SCORING_RANK_TIER_SILVER_MIN_XP=1500
SCORING_RANK_TIER_GOLD_MIN_XP=4000
SCORING_RANK_TIER_PLATINUM_MIN_XP=9000
SCORING_RANK_TIER_DIAMOND_MIN_XP=15000
SCORING_LEADERBOARD_PROMOTION_RULE=Top 25 move toward the next rank tier when the season locks.
SCORING_LEADERBOARD_RESET_RULE=Weekly XP resets after the window; total XP and score evidence are retained.
